# ─── Azure AI Foundry ─────────────────────────────────────────────────────────
# Local dev uses an API key. Deployed environments use managed identity instead
# (DefaultAzureCredential, scope https://cognitiveservices.azure.com/.default,
# role "Cognitive Services OpenAI User") and set neither of these.

AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_FOUNDRY_API_KEY=

# Deployment name as it appears in the Foundry portal.
AZURE_FOUNDRY_IMAGE_DEPLOYMENT=gpt-image-2

# /images/generations works on 2024-02-01.
# /images/edits returns 404 on 2024-02-01 and requires 2025-04-01-preview.
AZURE_FOUNDRY_API_VERSION_GENERATIONS=2024-02-01
AZURE_FOUNDRY_API_VERSION_EDITS=2025-04-01-preview

# ─── Database ─────────────────────────────────────────────────────────────────
# Local: docker compose. Deployed: PostgreSQL Flexible Server with Entra auth
# (no password in the URL).
DATABASE_URL=postgresql+psycopg://emulsion:emulsion@localhost:5432/emulsion

# ─── Blob storage ─────────────────────────────────────────────────────────────
# Local: azurite (emulates blob AND queue, so the real BlobStore/Queue
# implementations run unchanged). Deployed: managed identity, no connection string.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_ACCOUNT=
BLOB_CONTAINER_ORIGINALS=originals
BLOB_CONTAINER_DERIVATIVES=derivatives

# ─── Job queue ────────────────────────────────────────────────────────────────
QUEUE_NAME=emulsion-jobs

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Key Vault holds the master key that wraps per-user BYOK data-encryption keys.
# Deployed: accessed via managed identity.
AZURE_KEY_VAULT_URL=
# Local only — a base64 32-byte key standing in for Key Vault.
BYOK_MASTER_KEY_LOCAL=

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=local
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# ─── Telemetry ────────────────────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ─── Tests ────────────────────────────────────────────────────────────────────
# The end-to-end smoke test costs real money. Unset by default so CI skips it.
RUN_LIVE_SMOKE_TESTS=

# --- auth -------------------------------------------------------------------
# `dev` (default) is a single implicit local user and needs no account, which is what
# keeps `make dev` working with nothing installed. `clerk` verifies real session JWTs.
EMULSION_AUTH=dev
# Only needed when EMULSION_AUTH=clerk:
# CLERK_JWKS_URL=https://YOUR-APP.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://YOUR-APP.clerk.accounts.dev
# CLERK_AUDIENCE=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
